# Copie ce fichier vers .env.production sur le serveur et remplace chaque valeur.
# Ne commit jamais le fichier .env.production réel.

NODE_ENV=production
PORT=3000

# Base de données SQL utilisée par la session existante
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Base de données métier MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE

# Session locale et sécurité
JWT_SECRET=replace-with-a-long-random-secret

# Identité et configuration OAuth historique du projet
VITE_APP_ID=replace-with-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im
OWNER_OPEN_ID=replace-with-owner-open-id
OWNER_NAME=Kaba Admin

# APIs internes / stockage utilisés par le serveur
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=replace-with-server-key

# Origine publique de production
PUBLIC_ORIGIN=https://kaba.digital
